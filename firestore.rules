rules_version = '2';

// 커플 여행 지도 — 커플 두 사람만 자기 데이터에 접근할 수 있음
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function couple(id) { return get(/databases/$(database)/documents/couples/$(id)).data; }
    function isMember(id) { return signedIn() && request.auth.uid in couple(id).members; }

    // 내 프로필·연결 정보: 나만
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // 초대 코드 → 커플 문서 찾기. 코드를 아는 사람만 하나씩 조회 가능(목록 조회 불가)
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in getAfter(/databases/$(database)/documents/couples/$(request.resource.data.coupleId)).data.members;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /couples/{coupleId} {
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.owner == request.auth.uid;

      // 멤버이거나, 아직 짝꿍을 기다리는 커플(초대 코드로 찾아온 사람이 확인용으로 읽음)
      allow get: if signedIn()
        && (request.auth.uid in resource.data.members || resource.data.members.size() == 1);
      allow list: if false;

      // 멤버는 수정 가능. 짝꿍은 유효한 초대가 있을 때 "자기 자신만" 멤버로 추가 가능
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members
        || (resource.data.members.size() == 1
            && request.resource.data.members == resource.data.members.concat([request.auth.uid])
            && resource.data.inviteExpires > request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'profiles', 'joinedAt'])
            && request.resource.data.profiles.diff(resource.data.profiles).affectedKeys().hasOnly([request.auth.uid]))
      );
      allow delete: if false;

      // 도시별 일정(plans)·공유 설정(meta): 멤버만
      match /{sub=**} {
        allow read, write: if isMember(coupleId);
      }
    }
  }
}
